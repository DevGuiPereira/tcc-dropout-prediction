# ---------------------------------------------------------------------------
# Credenciais do banco MySQL — TCC Predição de Evasão
#
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` está no .gitignore e NUNCA deve ser versionado.
#
# Se estas variáveis não estiverem definidas (ou a conexão falhar por qualquer
# motivo), o pipeline baixa automaticamente os dados do UCI id=697. Nenhum
# notebook precisa ser alterado.
# ---------------------------------------------------------------------------

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_TABLE=

# MYSQL_TABLE aceita tabela ou view. É validado contra [A-Za-z0-9_$.]+ antes de
# entrar na query. Para forçar o uso do UCI, comente MYSQL_DATABASE.
